# Virtualenv — recreated from requirements.txt, never committed
.venv/

# Local SQLite database. Real data does not belong in git.
db.sqlite3

__pycache__/
*.py[cod]

# Secrets, once settings read from the environment. The glob catches
# .env.local, .env.production and the occasional mistyped .env-- ;
# the template is the one file here that is meant to be committed.
.env*
!.env.example
media/

# Collected by `manage.py collectstatic` at deploy time.
staticfiles/
