# Copy to .env for local development. .env is gitignored — never commit secrets.
#
#   cp .env.example .env

# Turns on debug pages, permissive CORS defaults and a throwaway secret key.
# NEVER set this in production: debug pages expose source code and settings.
DJANGO_DEBUG=1

# Required when DJANGO_DEBUG is off. Generate one with:
#   .venv/Scripts/python.exe -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# DJANGO_SECRET_KEY=

# Comma-separated. Required in production.
# DJANGO_ALLOWED_HOSTS=paylesshopmore.com,www.paylesshopmore.com

# Origins allowed to call the API with cookies. Defaults to the Vite dev
# server while DEBUG is on.
# DJANGO_CORS_ORIGINS=https://paylesshopmore.com
# DJANGO_CSRF_ORIGINS=https://paylesshopmore.com

# Vercel gives every preview deployment its own hostname, so no list written
# in advance can name them. A regex can. Anchor it, escape the dots, and name
# your own project — a careless pattern here is an open API.
# DJANGO_CORS_ORIGIN_REGEX=^https://paylesshopmore-[a-z0-9-]+\.vercel\.app$

# Cookies. Leave this OFF, which is the default and means SameSite=Lax.
#
# It is only correct to turn on if the site and the API really are on
# different origins. The deployment this project is set up for avoids that:
# Vercel rewrites /api to the API, so the browser sees one origin and the
# session cookie is first-party. Turning this on sets SameSite=None, which
# Safari discards and Firefox partitions — customers using either would not
# stay signed in.
# DJANGO_CROSS_SITE_COOKIES=0

# How long a signed-in session lasts, in seconds. Default is fourteen days.
# DJANGO_SESSION_COOKIE_AGE=1209600

# --- Database ---------------------------------------------------------------
# Three ways in, tried in this order. Leave all of them unset for SQLite,
# which is fine for development and refused outright when DJANGO_DEBUG is off.
#
# 1. One URL, which is what Neon, Supabase, Railway, Render and Heroku hand
#    out. Percent-encode any @ / : or # in the password.
# DATABASE_URL=postgres://user:password@host:5432/paylesshopmore
#
# 2. Or the separate variables, which are clearer in a compose file.
# POSTGRES_DB=paylesshopmore
# POSTGRES_USER=paylesshopmore
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# How long a database connection is kept open between requests. 60 is right
# for a long-lived process. Set it to 0 behind a transaction-mode pooler
# (PgBouncer, Supabase port 6543) or on anything serverless, where a reused
# connection is never reused and a burst exhausts the pool.
# DJANGO_CONN_MAX_AGE=60

# Require TLS to the database. On by default whenever DJANGO_DEBUG is off.
# DJANGO_DB_SSL_REQUIRE=1

# --- File storage -----------------------------------------------------------
# Where invoice PDFs and quote attachments are kept.
#
# Unset means the local filesystem under backend/media, which is correct for
# development and for a host with a persistent disk. It is wrong anywhere the
# process can be replaced without warning, or wherever more than one web
# process runs: an invoice written by one of them is simply not there when
# another is asked for it.
#
# Setting the bucket name switches to any S3-compatible store. Requires
# requirements-prod.txt, which brings django-storages and boto3.
#
# The bucket must be PRIVATE. Every file in it is served by a Django view
# that checks who is asking; a public bucket makes that check bypassable by
# anyone who can guess a filename.
# AWS_STORAGE_BUCKET_NAME=paylesshopmore-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=auto
# Leave unset for Amazon S3 itself. Required for everyone else, e.g.
#   Cloudflare R2  https://<account-id>.r2.cloudflarestorage.com
#   Backblaze B2   https://s3.<region>.backblazeb2.com
#   DO Spaces      https://<region>.digitaloceanspaces.com
# AWS_S3_ENDPOINT_URL=
# 'virtual' suits S3 and R2; some providers and MinIO need 'path'.
# AWS_S3_ADDRESSING_STYLE=virtual

# --- E-mail -----------------------------------------------------------------
# Used for password-reset links. While DJANGO_DEBUG is on the message is
# printed to the console the server runs in, so a reset can be followed
# end to end without an SMTP server or a real inbox.
#
# In production these are required, or no reset mail ever arrives.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DJANGO_FROM_EMAIL=PayLesShopMore <noreply@paylesshopmore.com>

# Where the React app is served. The reset link is opened from a mail client,
# so it has to be absolute. Defaults to the Vite dev server.
# DJANGO_FRONTEND_URL=https://paylesshopmore.com

# How long a reset link stays valid, in seconds. Default one hour.
# DJANGO_PASSWORD_RESET_TIMEOUT=3600

# --- Background tasks -------------------------------------------------------
# No broker means invoice rendering happens inline, in the request that
# approved the invoice. Fine for development; set this in production and run
# a worker beside the web process:
#
#   celery -A config worker --loglevel=info
# CELERY_BROKER_URL=redis://localhost:6379/0

# --- Cache ------------------------------------------------------------------
# Shared cache. Without it each worker process keeps its own, and the API rate
# limits become the configured rate multiplied by the number of processes.
# REDIS_URL=redis://localhost:6379/1

# --- Logging and error reporting --------------------------------------------
# DEBUG, INFO, WARNING or ERROR. Everything is written to stdout.
# DJANGO_LOG_LEVEL=INFO

# Optional. With no DSN nothing is sent and sentry-sdk is not even imported.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0

# --- Transport security -----------------------------------------------------
# How long browsers should refuse plain HTTP, in seconds. Start small while
# testing: this is hard to undo once browsers have cached it. Default one year.
# DJANGO_HSTS_SECONDS=31536000
