# Copy to .env for local development. .env is gitignored — never commit secrets.
#
#   cp .env.example .env

# Turns on debug pages, permissive CORS defaults and a throwaway secret key.
# NEVER set this in production: debug pages expose source code and settings.
DJANGO_DEBUG=1

# Required when DJANGO_DEBUG is off. Generate one with:
#   .venv/Scripts/python.exe -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# DJANGO_SECRET_KEY=

# Comma-separated. Required in production.
# DJANGO_ALLOWED_HOSTS=paylesshopmore.com,www.paylesshopmore.com

# Origins allowed to call the API with cookies. Defaults to the Vite dev
# server while DEBUG is on.
# DJANGO_CORS_ORIGINS=https://paylesshopmore.com
# DJANGO_CSRF_ORIGINS=https://paylesshopmore.com

# Leave unset to use SQLite. Setting POSTGRES_DB switches to PostgreSQL.
# POSTGRES_DB=paylesshopmore
# POSTGRES_USER=paylesshopmore
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- E-mail -----------------------------------------------------------------
# Used for password-reset links. While DJANGO_DEBUG is on the message is
# printed to the console the server runs in, so a reset can be followed
# end to end without an SMTP server or a real inbox.
#
# In production these are required, or no reset mail ever arrives.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DJANGO_FROM_EMAIL=PayLesShopMore <noreply@paylesshopmore.com>

# Where the React app is served. The reset link is opened from a mail client,
# so it has to be absolute. Defaults to the Vite dev server.
# DJANGO_FRONTEND_URL=https://paylesshopmore.com

# How long a reset link stays valid, in seconds. Default one hour.
# DJANGO_PASSWORD_RESET_TIMEOUT=3600
